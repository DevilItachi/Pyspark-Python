from pyspark.sql import functions as F
from pyspark.sql.window import Window

# COMMAND ----------
# 1. Source Data (Incoming incremental data)

data = [
    (1, "Ravi", "Delhi",   "2025-01-01"),
    (1, "Ravi", "Mumbai",  "2025-03-01"),
    (2, "Anita","Chennai", "2025-01-10"),
    (2, "Anita","Chennai", "2025-02-10"),
    (3, "John", "Pune",    "2025-02-01")
]

columns = ["cust_id", "name", "city", "update_date"]

df_src = (
    spark.createDataFrame(data, columns)
         .withColumn("update_date", F.to_date("update_date"))
)

display(df_src)

# COMMAND ----------
# 2. Window specification (per customer, ordered by date)

window_spec = (
    Window
    .partitionBy("cust_id")
    .orderBy("update_date")
)

# COMMAND ----------
# 3. Detect changes using lag()

df_changes = (
    df_src
    .withColumn("prev_city", F.lag("city").over(window_spec))
    .withColumn(
        "is_changed",
        F.when(F.col("prev_city").isNull(), 1)
         .when(F.col("city") != F.col("prev_city"), 1)
         .otherwise(0)
    )
)

display(df_changes)

# COMMAND ----------
# 4. Keep only changed records (SCD Type 2 rows)

df_scd_stage = (
    df_changes
    .filter(F.col("is_changed") == 1)
    .withColumn("effective_start_date", F.col("update_date"))
    .withColumn(
        "effective_end_date",
        F.date_sub(F.lead("update_date").over(window_spec), 1)
    )
    .withColumn(
        "current_flag",
        F.when(F.col("effective_end_date").isNull(), "Y")
         .otherwise("N")
    )
)

display(df_scd_stage)

# COMMAND ----------
# 5. Final Dimension Structure

df_dim_customer = (
    df_scd_stage
    .select(
        "cust_id",
        "name",
        "city",
        "effective_start_date",
        "effective_end_date",
        "current_flag"
    )
)

display(df_dim_customer)

